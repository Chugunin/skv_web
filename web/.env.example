# Public site URL. Required in production for canonical URLs, OG and sitemap.
SITE=http://localhost:4321

# Directus instance used by Astro during development/build.
DIRECTUS_URL=http://localhost:8055

# Public Directus URL embedded into generated HTML for /assets/* links.
# In production this must be reachable from visitors' browsers.
PUBLIC_DIRECTUS_URL=http://localhost:8055

# Optional development-only escape hatch.
# true = if Directus is unavailable during `astro dev`, use local Journal fixtures.
# Production/static builds NEVER use this fallback.
DIRECTUS_DEV_FALLBACK=false

# Endpoint формы (CRM / email gateway / server endpoint). Пока пусто — отправка отключена.
PUBLIC_CONTACT_ENDPOINT=
