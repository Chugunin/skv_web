---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import TherapyHero from "@components/therapy/TherapyHero.astro";
import Foundation from "@components/therapy/Foundation.astro";
import Areas from "@components/therapy/Areas.astro";
import MethodAndApproach from "@components/therapy/MethodAndApproach.astro";
import Formats from "@components/therapy/Formats.astro";
import Opportunities from "@components/therapy/Opportunities.astro";
import Dialog from "@components/therapy/Dialog.astro";
---
<BaseLayout
  title="SKV Therapy — психологическая работа"
  description="SKV Therapy — психологическая работа с восприятием, внутренними процессами, отношениями и устойчивыми жизненными изменениями."
  image="/assets/reference/therapy-hero.webp"
  preloadImage="/assets/reference/therapy-hero.webp"
>
  <Header />
  <main id="main-content" tabindex="-1">
    <TherapyHero />
    <Foundation />
    <Areas />
    <MethodAndApproach />
    <Formats />
    <Opportunities />
    <Dialog />
  </main>
  <Footer />
</BaseLayout>
