---
import BaseLayout from "@layouts/BaseLayout.astro";import Header from "@components/layout/Header.astro";import Footer from "@components/layout/Footer.astro";import Container from "@components/layout/Container.astro";import Button from "@components/common/Button.astro";import GeometricFigure from "@components/decorative/GeometricFigure.astro";import Reveal from "@components/decorative/Reveal.astro";
---
<BaseLayout title="SKV Practice" description="SKV Practice — практические материалы и инструменты для самостоятельной работы с мышлением, эмоциями и состоянием." noindex>
<Header/><main id="main-content" class="practice"><GeometricFigure class="practice__figure" size={300}/><Container><Reveal class="practice__content"><span>SKV Practice</span><h1>Практика самостоятельной работы</h1><p>Практические материалы и инструменты для самостоятельной работы с мышлением, эмоциями и состоянием.</p><p class="practice__note">Продуктовая модель направления пока не утверждена: каталог, цены, оплата и выдача материалов будут реализованы после закрытия OQ-01.</p><Button href="/#directions" variant="outline">Вернуться к направлениям</Button></Reveal></Container></main><Footer/>
</BaseLayout>
<style>.practice{position:relative;min-height:70vh;display:grid;align-items:center;padding:80px 0 120px;overflow:hidden}.practice__content{max-width:760px}.practice__content>span{font-size:12px;color:var(--color-accent-strong);text-transform:uppercase;letter-spacing:.08em}.practice h1{margin-top:14px;font-size:clamp(58px,7vw,100px)}.practice p{margin-top:28px;max-width:650px;font-size:17px;line-height:1.75}.practice__note{color:var(--color-muted);font-size:13px!important}.practice__content :global(.button){margin-top:34px}.practice__figure{position:absolute;right:6%;top:13%;opacity:.42}@media(max-width:700px){.practice__figure{right:-100px;opacity:.2}}</style>
