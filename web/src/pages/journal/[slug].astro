---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";

import {
    getArchive,
    getArticleBySlug
} from "@lib/repository";

import { formatDate } from "@lib/utils";
import ArticleMeta from "@/components/article/ArticleMeta.astro";

export async function getStaticPaths() {

    const articles = await getArchive();

    return articles.map(article => ({

        params: {

            slug: article.slug

        }

    }));

}

const { slug } = Astro.params;

const article = await getArticleBySlug(slug!);

if (!article) {

    return Astro.redirect("/journal");

}
---

<BaseLayout title={article.title}>

    <section class="article">

        <Container>

            <img
                    class="article__image"
                    src={article.image}
                    alt={article.title}
            />

            <ArticleMeta
                    date={article.date}
                    author={article.author}
                    readingTime={article.readingTime}
            />

            <h1>

                {article.title}

            </h1>

            <p class="lead">

                {article.description}

            </p>

            <div class="article__content">

                {

                    article.content ||

                    `Здесь будет содержимое статьи. Позже этот текст будет поступать из Directus.`

                }

            </div>

        </Container>

    </section>

</BaseLayout>

<style>

    .article{

        padding:160px 0 120px;

    }

    .article__image{

        width:100%;

        aspect-ratio:16/9;

        object-fit:cover;

        border-radius:12px;

        margin-bottom:40px;

    }

    .article__meta{

        display:flex;

        gap:24px;

        color:#777;

        font-size:14px;

        margin-bottom:18px;

    }

    .article h1{

        font-size:52px;

        font-weight:300;

        margin-bottom:28px;

    }

    .lead{

        font-size:22px;

        line-height:1.8;

        color:#555;

        margin-bottom:50px;

    }

    .article__content{

        font-size:18px;

        line-height:2;

        max-width:850px;

    }

</style>