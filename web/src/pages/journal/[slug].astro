---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import Container from "@components/layout/Container.astro";
import Button from "@components/common/Button.astro";
import ArticleMeta from "@components/article/ArticleMeta.astro";
import ArticleCard from "@components/article/ArticleCard.astro";
import ArticleContent from "@components/article/ArticleContent.astro";
import { getArticles, getArticleBySlug } from "@lib/repository";
import { config } from "@lib/config";
import { toIsoDate } from "@lib/utils";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map(article => ({ params: { slug: article.slug } }));
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug!);
if (!article) return Astro.redirect("/journal/");

const all = await getArticles();
const sameCategory = all.filter(item => item.slug !== article.slug && item.category?.slug === article.category?.slug);
const fallbackRelated = all.filter(item => item.slug !== article.slug && !sameCategory.some(same => same.slug === item.slug));
const related = [...sameCategory, ...fallbackRelated].slice(0, 3);

const title = article.seoTitle || `${article.title} — SKV Journal`;
const description = article.seoDescription || article.description;
const seoImage = article.seoImage || article.image;
const canonical = `/journal/${article.slug}/`;
const canonicalUrl = new URL(canonical, config.siteUrl).toString();
const imageUrl = seoImage ? new URL(seoImage, config.siteUrl).toString() : undefined;
const publishedIso = toIsoDate(article.date);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description,
  ...(publishedIso ? { datePublished: publishedIso, dateModified: publishedIso } : {}),
  mainEntityOfPage: canonicalUrl,
  author: { "@type": "Organization", name: article.author || "SKV" },
  publisher: { "@type": "Organization", name: "SKV", url: config.siteUrl },
  ...(imageUrl ? { image: [imageUrl] } : {})
};
---
<BaseLayout title={title} description={description} image={seoImage} canonical={canonical} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  {publishedIso && <meta slot="head" property="article:published_time" content={publishedIso} />}
  {article.category?.title && <meta slot="head" property="article:section" content={article.category.title} />}
  <Header />
  <main id="main-content" tabindex="-1">
    <article class="article">
      <Container>
        <header class="article__header">
          <a class="article__back" href="/journal/">← Journal</a>
          {article.category?.title && <span class="article__category">{article.category.title}</span>}
          <h1>{article.title}</h1>
          <p class="article__lead">{article.description}</p>
          <ArticleMeta date={article.date} author={article.author} readingTime={article.readingTime}/>
        </header>
        {article.image && <img class="article__cover" src={article.image} alt="" width="1600" height="850" loading="eager" decoding="async" fetchpriority="high" />}
        <div class="article__content"><ArticleContent content={article.content} /></div>
      </Container>
    </article>
    {related.length > 0 && <section class="related"><Container><h2>Связанные материалы</h2><div class="related__grid">{related.map(item=><ArticleCard article={item} compact />)}</div></Container></section>}
    <section class="article-cta"><Container><div><h2>Продолжить чтение</h2><p>Вернуться в интеллектуальную библиотеку SKV.</p></div><Button href="/journal/" variant="outline">Все материалы</Button></Container></section>
  </main>
  <Footer />
</BaseLayout>
<style>
.article{padding:clamp(70px,8vw,120px) 0}.article__header{max-width:960px;margin:0 auto 56px}.article__back{display:inline-block;margin-bottom:32px;font-size:12px;color:var(--color-accent-strong)}.article__category{display:block;text-transform:uppercase;letter-spacing:.07em;font-size:11px;color:var(--color-accent-strong)}.article h1{margin-top:14px;font-size:clamp(54px,7vw,96px);line-height:1.02}.article__lead{margin:28px 0 28px;max-width:780px;color:var(--color-muted);font-size:clamp(17px,1.5vw,22px);line-height:1.7}.article__cover{width:100%;max-height:680px;aspect-ratio:16/8.5;object-fit:cover}.article__content{max-width:780px;margin:64px auto 0}.related{padding:0 0 var(--section-space)}.related h2{font-size:clamp(42px,4.5vw,62px);margin-bottom:34px}.related__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.article-cta{padding:70px 0;border-top:1px solid var(--color-border)}.article-cta :global(.container){display:flex;justify-content:space-between;align-items:center;gap:32px}.article-cta h2{font-size:48px}.article-cta p{margin-top:12px;color:var(--color-muted);font-size:13px}@media(max-width:760px){.related__grid{grid-template-columns:1fr}.article-cta :global(.container){align-items:flex-start;flex-direction:column}.article__content{margin-top:42px}}
</style>
