---
interface Props {
  class?: string;
  size?: number;
  [key: string]: unknown;
}

// Геометрические линейные фигуры временно отключены на всём сайте.
// Компонент сохранён как единая точка возврата графики на следующем этапе.
const GEOMETRY_ENABLED = false;

const { class: className = "", size = 240, ...rest } = Astro.props;
---
{GEOMETRY_ENABLED && (
  <svg
    class={`geometric-figure ${className}`}
    width={size}
    height={size}
    viewBox="0 0 240 240"
    fill="none"
    aria-hidden="true"
    {...rest}
  >
    <g vector-effect="non-scaling-stroke">
      <path d="M40 62 106 22l73 34 28 72-36 69-83 22-63-51 15-106Z" />
      <path d="m40 62 72 48 67-54-73-34 6 88-24 109 83-22-59-87 95 18-95-18 59 87" />
      <path d="m25 168 87-58-72-48m48 157 24-109 67-54m-67 54 95 18m-95-18-87 58" />
    </g>
  </svg>
)}

<style>
  .geometric-figure{color:var(--color-accent);opacity:.7}
  .geometric-figure path{stroke:currentColor;stroke-width:.75;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:520;stroke-dashoffset:0}
  :global(html.js) [data-reveal] .geometric-figure path{stroke-dashoffset:520}
  :global(html.js) [data-reveal].is-visible .geometric-figure path,.geometric-figure.is-visible path{animation:figure-draw 1.45s cubic-bezier(.2,.7,.2,1) forwards}
  .geometric-figure path:nth-child(2){animation-delay:100ms!important}
  .geometric-figure path:nth-child(3){animation-delay:180ms!important}
  @keyframes figure-draw{to{stroke-dashoffset:0}}
  @media(prefers-reduced-motion:reduce){.geometric-figure path{stroke-dashoffset:0!important;animation:none!important}}
</style>
