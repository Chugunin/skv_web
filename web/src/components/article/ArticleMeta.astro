---
import { formatDate } from "@lib/utils";

interface Props {
  date: string;
  author?: string;
  readingTime?: number;
}

const { date, author, readingTime } = Astro.props;
const formattedDate = formatDate(date);
---

<div class="meta">
  {formattedDate && <time datetime={date}>{formattedDate}</time>}
  {author && <span>{author}</span>}
  {readingTime && <span>{readingTime} мин</span>}
</div>

<style>
  .meta { display: flex; gap: 22px; flex-wrap: wrap; color: #777; font-size: 14px; }
</style>
