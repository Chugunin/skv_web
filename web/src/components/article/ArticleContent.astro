---
interface Props { content?: string; }
const { content = "" } = Astro.props;
const hasHtml = /<\/?[a-z][\s\S]*>/i.test(content);
const paragraphs = hasHtml ? [] : content.split(/\n{2,}/).map(value => value.trim()).filter(Boolean);
---
<div class="article-content">
  {content ? (
    hasHtml ? <div class="article-content__rich" set:html={content} /> : paragraphs.map(paragraph => <p>{paragraph}</p>)
  ) : <p>Материал готовится к публикации.</p>}
</div>

<style>
.article-content{min-width:0;font-size:17px;line-height:1.92;color:#383532;overflow-wrap:anywhere}
.article-content :global(p){margin:0 0 1.35em}
.article-content :global(h2){margin:1.7em 0 .7em;font-size:clamp(34px,4vw,48px);line-height:1.08}
.article-content :global(h3){margin:1.6em 0 .65em;font-size:clamp(25px,3vw,34px);line-height:1.15}
.article-content :global(h4){margin:1.5em 0 .6em;font-size:clamp(20px,2.2vw,25px);line-height:1.2}
.article-content :global(ul),.article-content :global(ol){margin:1.15em 0 1.45em;padding-left:1.4em}
.article-content :global(li){margin:.45em 0}
.article-content :global(li>ul),.article-content :global(li>ol){margin:.45em 0 .7em}
.article-content :global(blockquote){margin:2em 0;padding:4px 0 4px 28px;border-left:1px solid var(--color-accent);font-family:Cormorant,serif;font-size:1.55em;line-height:1.35}
.article-content :global(blockquote p:last-child){margin-bottom:0}
.article-content :global(a){color:var(--color-accent-strong);text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
.article-content :global(img){display:block;margin:2.2em auto;width:100%;height:auto}
.article-content :global(figure){margin:2.4em 0}
.article-content :global(figure img){margin:0}
.article-content :global(figcaption){margin-top:.75em;color:var(--color-muted);font-size:.78em;line-height:1.55;text-align:center}
.article-content :global(hr){margin:2.5em 0;border:0;border-top:1px solid var(--color-border)}
.article-content :global(pre){max-width:100%;margin:1.8em 0;padding:18px 20px;overflow:auto;background:#2d2b29;color:#fff;font-size:.82em;line-height:1.6}
.article-content :global(code){font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.9em}
.article-content :global(:not(pre)>code){padding:.12em .35em;background:rgba(45,43,41,.07)}
.article-content :global(table){display:block;width:100%;max-width:100%;margin:2em 0;overflow-x:auto;border-collapse:collapse;font-size:.88em}
.article-content :global(th),.article-content :global(td){padding:10px 12px;border:1px solid var(--color-border);text-align:left;vertical-align:top}
.article-content :global(th){font-weight:600;background:rgba(45,43,41,.04)}
.article-content :global(iframe),.article-content :global(video){display:block;width:100%;max-width:100%;margin:2.2em 0;border:0}
@media(max-width:560px){.article-content{font-size:16px;line-height:1.82}.article-content :global(blockquote){padding-left:20px;font-size:1.4em}}
</style>
