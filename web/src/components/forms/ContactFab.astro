<button class="contact-fab" type="button" data-contact-fab data-contact-modal-open data-contact-source="fab" aria-label="Записаться на консультацию">
  <span class="contact-fab__icon" aria-hidden="true"><span>↗</span></span>
  <span class="contact-fab__label">Записаться на консультацию</span>
</button>

<script>
  const fab = document.querySelector<HTMLElement>("[data-contact-fab]");
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const hideTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-contact-fab-hide]"));

  if (fab && header) {
    let headerVisible = true;
    const visibleHideTargets = new Set<Element>();

    const syncVisibility = () => {
      fab.classList.toggle("is-visible", !headerVisible && visibleHideTargets.size === 0);
    };

    const headerObserver = new IntersectionObserver(([entry]) => {
      headerVisible = entry.isIntersecting;
      syncVisibility();
    }, { threshold: 0 });
    headerObserver.observe(header);

    if (hideTargets.length > 0) {
      const targetObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visibleHideTargets.add(entry.target);
          else visibleHideTargets.delete(entry.target);
        }
        syncVisibility();
      }, { threshold: 0.08 });
      hideTargets.forEach((target) => targetObserver.observe(target));
    }
  }
</script>

<style>
  .contact-fab {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 52px;
    padding: 7px 17px 7px 8px;
    border: 1px solid rgba(185,132,63,.42);
    border-radius: 999px;
    background: rgba(250,247,242,.72);
    color: var(--color-text);
    box-shadow: 0 10px 30px rgba(45,39,34,.12), inset 0 1px 0 rgba(255,255,255,.52);
    -webkit-backdrop-filter: blur(14px) saturate(1.06);
    backdrop-filter: blur(14px) saturate(1.06);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .01em;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 110ms ease, visibility 110ms ease, background-color 150ms ease, border-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
  }
  .contact-fab.is-visible { opacity: 1; visibility: visible; pointer-events: auto; }
  .contact-fab:hover,
  .contact-fab:focus-visible {
    background: rgba(91,67,39,.88);
    border-color: rgba(91,67,39,.72);
    color: var(--color-surface);
    box-shadow: 0 12px 32px rgba(45,39,34,.18), inset 0 1px 0 rgba(255,255,255,.14);
    outline: none;
  }
  .contact-fab:active { background: rgba(45,39,34,.92); }
  .contact-fab__icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid rgba(185,132,63,.28);
    border-radius: 50%;
    background: rgba(255,255,255,.34);
  }
  .contact-fab:hover .contact-fab__icon,
  .contact-fab:focus-visible .contact-fab__icon { border-color: rgba(255,255,255,.24); background: rgba(255,255,255,.12); }
  .contact-fab__icon span { display: block; font-size: 18px; line-height: 1; transform-origin: 50% 50%; animation: contact-fab-spin 3.6s linear infinite; }
  :global(html.contact-modal-open) .contact-fab { opacity: 0; visibility: hidden; pointer-events: none; }
  @keyframes contact-fab-spin {
    0%, 82% { transform: rotate(0deg); }
    92%, 100% { transform: rotate(360deg); }
  }
  @media (max-width: 620px) {
    .contact-fab { right: max(12px, env(safe-area-inset-right)); bottom: max(12px, env(safe-area-inset-bottom)); max-width: calc(100vw - 24px); min-height: 50px; padding-right: 14px; }
    .contact-fab__label { white-space: nowrap; font-size: 11px; }
    .contact-fab__icon { width: 34px; height: 34px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-fab, .contact-fab__icon span { transition: none; animation: none; }
  }
</style>
