<button class="contact-fab" type="button" data-contact-fab data-contact-modal-open data-contact-source="fab" aria-label="Записаться на консультацию">
  <span class="contact-fab__label">Записаться на консультацию</span>
  <span class="contact-fab__icon" aria-hidden="true"><span>↗</span></span>
</button>

<script>
  const fab = document.querySelector<HTMLElement>("[data-contact-fab]");
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  if (fab && header) {
    const observer = new IntersectionObserver(([entry]) => {
      fab.classList.toggle("is-visible", !entry.isIntersecting);
    }, { threshold: 0 });
    observer.observe(header);
  }
</script>

<style>
  .contact-fab { position: fixed; right: max(20px, calc((100vw - var(--container-width)) / 2)); bottom: 24px; z-index: 80; display: inline-flex; align-items: center; gap: 14px; min-height: 54px; padding: 8px 9px 8px 18px; border: 1px solid var(--color-accent); border-radius: 999px; background: var(--color-accent); color: var(--color-surface); box-shadow: 0 14px 34px rgba(91,67,39,.2); font-size: 12px; font-weight: 600; letter-spacing: .01em; opacity: 0; visibility: hidden; transform: translateY(16px); pointer-events: none; transition: opacity 220ms ease, transform 220ms ease, visibility 220ms ease, background var(--transition-fast); }
  .contact-fab.is-visible { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; }
  .contact-fab:hover, .contact-fab:focus-visible { background: var(--color-accent-strong); outline: none; }
  .contact-fab__icon { width: 38px; height: 38px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 50%; background: rgba(255,255,255,.16); overflow: hidden; }
  .contact-fab__icon span { display: block; font-size: 19px; line-height: 1; animation: contact-fab-arrow 2.8s ease-in-out infinite; }
  :global(html.contact-modal-open) .contact-fab { opacity: 0; visibility: hidden; pointer-events: none; transform: translateY(16px); }
  @keyframes contact-fab-arrow { 0%, 72%, 100% { transform: translate(0,0); } 82% { transform: translate(3px,-3px); } 90% { transform: translate(0,0); } }
  @media (max-width: 620px) {
    .contact-fab { right: 14px; bottom: max(14px, env(safe-area-inset-bottom)); max-width: calc(100vw - 28px); min-height: 50px; padding-left: 15px; }
    .contact-fab__label { white-space: nowrap; font-size: 11px; }
    .contact-fab__icon { width: 34px; height: 34px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-fab, .contact-fab__icon span { transition: none; animation: none; }
  }
</style>
