<button class="contact-fab" type="button" data-contact-fab data-contact-modal-open data-contact-source="fab" aria-label="Записаться на консультацию">
  <span class="contact-fab__icon" aria-hidden="true"><span>↗</span></span>
  <span class="contact-fab__label">Записаться на консультацию</span>
</button>

<script>
  const fab = document.querySelector<HTMLElement>("[data-contact-fab]");
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const hideTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-contact-fab-hide]"));

  if (fab && header) {
    let headerVisible = true;
    const visibleHideTargets = new Set<Element>();

    const syncVisibility = () => {
      fab.classList.toggle("is-visible", !headerVisible && visibleHideTargets.size === 0);
    };

    const headerObserver = new IntersectionObserver(([entry]) => {
      headerVisible = entry.isIntersecting;
      syncVisibility();
    }, { threshold: 0 });
    headerObserver.observe(header);

    if (hideTargets.length > 0) {
      const targetObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visibleHideTargets.add(entry.target);
          else visibleHideTargets.delete(entry.target);
        }
        syncVisibility();
      }, { threshold: 0.08 });
      hideTargets.forEach((target) => targetObserver.observe(target));
    }
  }
</script>

<style>
  .contact-fab {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 52px;
    padding: 7px 17px 7px 8px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 32%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 46%, transparent);
    color: var(--color-text);
    box-shadow:
      0 10px 30px rgba(23, 22, 20, .09),
      inset 0 1px 0 rgba(255, 255, 255, .46);
    -webkit-backdrop-filter: blur(16px) saturate(1.12);
    backdrop-filter: blur(16px) saturate(1.12);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .01em;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 420ms cubic-bezier(.22, .61, .36, 1),
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  .contact-fab.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .contact-fab:hover,
  .contact-fab:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 48%, transparent);
    color: var(--color-text);
    box-shadow:
      0 12px 32px rgba(23, 22, 20, .12),
      inset 0 1px 0 rgba(255, 255, 255, .34);
    outline: none;
  }

  .contact-fab:active {
    background: color-mix(in srgb, var(--color-accent) 24%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 58%, transparent);
  }

  .contact-fab__icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-surface) 32%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .contact-fab:hover .contact-fab__icon,
  .contact-fab:focus-visible .contact-fab__icon {
    border-color: color-mix(in srgb, var(--color-accent) 46%, transparent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .contact-fab__icon span {
    display: block;
    font-size: 18px;
    line-height: 1;
    transform-origin: 50% 50%;
    animation: contact-fab-spin 3.6s linear infinite;
  }

  :global(html.contact-modal-open) .contact-fab {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @keyframes contact-fab-spin {
    0%, 82% { transform: rotate(0deg); }
    92%, 100% { transform: rotate(360deg); }
  }

  @media (max-width: 620px) {
    .contact-fab {
      right: max(12px, env(safe-area-inset-right));
      bottom: max(12px, env(safe-area-inset-bottom));
      max-width: calc(100vw - 24px);
      min-height: 50px;
      padding-right: 14px;
    }
    .contact-fab__label { white-space: nowrap; font-size: 11px; }
    .contact-fab__icon { width: 34px; height: 34px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-fab, .contact-fab__icon span { transition: none; animation: none; }
  }
</style>
