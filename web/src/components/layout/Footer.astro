---
import Container from "./Container.astro";
import { navigation } from "@lib/navigation";
---
<footer class="site-footer">
  <Container>
    <div class="site-footer__main">
      <a href="/" class="brand" aria-label="SKV — главная">SKV</a>
      <nav aria-label="Навигация в подвале">{navigation.slice(1, 4).map((item) => <a href={item.href}>{item.title}</a>)}</nav>
      <div class="social" aria-label="Социальные сети"><slot name="social" /></div>
    </div>
    <div class="site-footer__meta">
      <span>© SKV, 2026</span>
      <a href="/privacy/">Политика конфиденциальности</a>
    </div>
  </Container>
</footer>

<style>
  .site-footer { padding: 26px 0 18px; border-top: 1px solid var(--color-line); background: var(--color-background); }
  .site-footer__main { min-height: 52px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 28px; }
  .brand { justify-self: start; font-family: "Cormorant Garamond", Cormorant, serif; font-size: 28px; color: var(--color-accent); }
  nav { display: flex; gap: clamp(22px, 3vw, 44px); font-size: 12px; }
  .social { justify-self: end; min-height: 1px; }
  .site-footer__meta { display: flex; justify-content: space-between; gap: 24px; padding-top: 14px; border-top: 1px solid var(--color-border); color: var(--color-muted); font-size: 11px; }
  @media (max-width: 760px) {
    .site-footer__main { grid-template-columns: 1fr; align-items: start; }
    nav { flex-wrap: wrap; }
    .social { justify-self: start; }
  }
</style>
