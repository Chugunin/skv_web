---
import Container from "./Container.astro";
---

<footer>

    <Container>

        <div class="top">

            <div>

                <h3>

                    SKV

                </h3>

                <p>

                    Psychology Journal

                </p>

            </div>

            <nav>

                <a href="#">

                    Главная

                </a>

                <a href="#">

                    Journal

                </a>

                <a href="#">

                    Контакты

                </a>

            </nav>

        </div>

        <div class="bottom">

            © 2026 SKV

        </div>

    </Container>

</footer>

<style>

    footer{

        background:#252321;

        color:white;

        padding:80px 0;

    }

    .top{

        display:flex;

        justify-content:space-between;

        align-items:flex-start;

        padding-bottom:45px;

        border-bottom:1px solid rgba(255,255,255,.15);

    }

    .top nav{

        display:flex;

        gap:35px;

    }

    .top a{

        color:white;

        opacity:.85;

    }

    .top a:hover{

        opacity:1;

    }

    .bottom{

        padding-top:30px;

        opacity:.55;

    }

    @media(max-width:900px){

        .top{

            flex-direction:column;

            gap:30px;

        }

        .top nav{

            flex-wrap:wrap;

        }

    }

</style>