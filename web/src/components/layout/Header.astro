---
import Container from "./Container.astro";
import Button from "@components/common/Button.astro";
import { navigation } from "@lib/navigation";

const path = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? path === "/" : href.startsWith("/#") ? false : path.startsWith(href);
---
<header class="site-header">
  <Container>
    <div class="site-header__inner">
      <a href="/" class="brand" aria-label="SKV — главная">SKV</a>

      <nav class="desktop-nav" aria-label="Основная навигация">
        {navigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.title}</a>
        ))}
      </nav>

      <div class="site-header__cta">
        <Button href="/#contact" variant="outline">Записаться<br />на консультацию</Button>
      </div>

      <details class="mobile-nav">
        <summary aria-label="Открыть меню"><span></span><span></span></summary>
        <nav aria-label="Мобильная навигация">
          {navigation.map((item) => <a href={item.href}>{item.title}</a>)}
          <Button href="/#contact" variant="outline">Записаться на консультацию</Button>
        </nav>
      </details>
    </div>
  </Container>
</header>

<style>
  .site-header { position: relative; z-index: 50; padding-block: 20px; background: transparent; }
  .site-header__inner { min-height: 56px; display: grid; grid-template-columns: minmax(110px, 1fr) auto minmax(180px, 1fr); align-items: center; gap: 32px; }
  .brand { justify-self: start; font-family: "Cormorant Garamond", Cormorant, serif; font-size: 36px; line-height: 1; color: var(--color-accent); letter-spacing: -0.05em; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(24px, 3vw, 50px); font-size: 13px; }
  .desktop-nav a { position: relative; padding-block: 8px; }
  .desktop-nav a[aria-current="page"]::after { content: ""; position: absolute; inset-inline: 0; bottom: 0; height: 1px; background: var(--color-accent); }
  .site-header__cta { justify-self: end; }
  .site-header__cta :global(.button) { text-align: center; line-height: 1.4; gap: 12px; min-width: 164px; }
  .mobile-nav { display: none; }

  @media (max-width: 900px) {
    .site-header__inner { grid-template-columns: 1fr auto; }
    .desktop-nav, .site-header__cta { display: none; }
    .mobile-nav { display: block; position: relative; }
    .mobile-nav summary { list-style: none; width: 44px; height: 44px; display: grid; place-content: center; gap: 6px; border: 1px solid var(--color-border); cursor: pointer; }
    .mobile-nav summary::-webkit-details-marker { display: none; }
    .mobile-nav summary span { width: 18px; height: 1px; background: var(--color-text); }
    .mobile-nav nav { position: absolute; right: 0; top: calc(100% + 10px); width: min(82vw, 340px); padding: 24px; display: grid; gap: 18px; background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--shadow-soft); }
  }
</style>
