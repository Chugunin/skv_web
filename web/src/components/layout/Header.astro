<header id="site-header" class="header">

    <div class="header__container">

        <a href="/" class="logo">

            SKV

        </a>

        <nav>

            <a href="/">Главная</a>

            <a href="/journal" class="active">Journal</a>

        </nav>

    </div>

</header>

<script type="module">

    const header = document.getElementById("site-header");

    if (header) {

        const update = () => {

            header.classList.toggle(
                "header--scrolled",
                window.scrollY > 40
            );

        };

        update();

        window.addEventListener("scroll", update, {
            passive: true
        });

    }

</script>

<style>

    .header{

        position:fixed;

        inset-inline:0;

        top:0;

        z-index:1000;

        padding:22px 0;

        transition:
                background .3s,
                backdrop-filter .3s,
                box-shadow .3s,
                padding .3s;

    }

    .header--scrolled{

        background:rgba(34,34,34,.82);

        backdrop-filter:blur(12px);

        box-shadow:0 10px 30px rgba(0,0,0,.18);

        padding:16px 0;

    }

    .header__container{

        width:min(
                calc(100% - var(--container-padding)*2),
                var(--container-width)
        );

        margin-inline:auto;

        display:flex;

        justify-content:space-between;

        align-items:center;

    }

    .logo{

        color:white;

        font-size:24px;

        letter-spacing:.12em;

    }

    nav{

        display:flex;

        gap:36px;

    }

    nav a{

        color:white;

        opacity:.75;

        transition:.25s;

    }

    nav a:hover{

        opacity:1;

    }

    .active{

        opacity:1;

        position:relative;

    }

    .active::after{

        content:"";

        position:absolute;

        left:0;

        right:0;

        bottom:-6px;

        height:2px;

        background:white;

    }

</style>