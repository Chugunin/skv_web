---
import Container from "./Container.astro";
import Button from "@components/common/Button.astro";
import { navigation } from "@lib/navigation";

const path = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? path === "/" : href.startsWith("/#") ? false : path.startsWith(href);
---
<header class="site-header" data-site-header>
  <Container>
    <div class="site-header__inner">
      <a href="/" class="brand" aria-label="SKV — главная">SKV</a>

      <nav class="desktop-nav" aria-label="Основная навигация">
        {navigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.title}</a>
        ))}
      </nav>

      <div class="site-header__cta">
        <Button href="/#contact" variant="outline">Записаться<br />на консультацию</Button>
      </div>

      <div class="mobile-nav">
        <button class="mobile-nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Открыть меню" data-mobile-toggle>
          <span></span><span></span>
        </button>
        <nav id="mobile-menu" class="mobile-nav__panel" aria-label="Мобильная навигация" hidden data-mobile-panel>
          {navigation.map((item) => <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.title}</a>)}
          <Button href="/#contact" variant="outline">Записаться на консультацию</Button>
        </nav>
        <nav class="mobile-nav__fallback" aria-label="Мобильная навигация">
          {navigation.map((item) => <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.title}</a>)}
          <a href="/#contact">Записаться на консультацию</a>
        </nav>
      </div>
    </div>
  </Container>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const panel = header?.querySelector<HTMLElement>("[data-mobile-panel]");

  const close = (restoreFocus = false) => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Открыть меню");
    panel.hidden = true;
    document.documentElement.classList.remove("mobile-menu-open");
    if (restoreFocus) toggle.focus();
  };

  const open = () => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Закрыть меню");
    panel.hidden = false;
    document.documentElement.classList.add("mobile-menu-open");
    panel.querySelector<HTMLElement>("a, button")?.focus();
  };

  toggle?.addEventListener("click", () => toggle.getAttribute("aria-expanded") === "true" ? close() : open());
  panel?.addEventListener("click", (event) => { if ((event.target as HTMLElement).closest("a")) close(); });
  document.addEventListener("keydown", (event) => {
    if (toggle?.getAttribute("aria-expanded") !== "true" || !panel) return;

    if (event.key === "Escape") {
      close(true);
      return;
    }

    if (event.key === "Tab") {
      const panelFocusable = Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'));
      const focusable = [toggle, ...panelFocusable];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });
  document.addEventListener("pointerdown", (event) => {
    if (toggle?.getAttribute("aria-expanded") !== "true" || !header) return;
    if (!header.contains(event.target as Node)) close();
  });

  const desktopQuery = window.matchMedia("(min-width: 901px)");
  desktopQuery.addEventListener("change", (event) => { if (event.matches) close(); });
</script>

<style>
  .site-header { position: relative; z-index: 50; padding-block: 20px; background: transparent; }
  .site-header__inner { min-height: 56px; display: grid; grid-template-columns: minmax(110px, 1fr) auto minmax(180px, 1fr); align-items: center; gap: 32px; }
  .brand { justify-self: start; font-family: "Cormorant Garamond", Cormorant, serif; font-size: 36px; line-height: 1; color: var(--color-accent); letter-spacing: -0.05em; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(24px, 3vw, 50px); font-size: 13px; }
  .desktop-nav a { position: relative; padding-block: 8px; }
  .desktop-nav a[aria-current="page"]::after { content: ""; position: absolute; inset-inline: 0; bottom: 0; height: 1px; background: var(--color-accent); }
  .site-header__cta { justify-self: end; }
  .site-header__cta :global(.button) { text-align: center; line-height: 1.4; gap: 12px; min-width: 164px; }
  .mobile-nav { display: none; }

  @media (max-width: 900px) {
    .site-header__inner { grid-template-columns: 1fr auto; }
    .desktop-nav, .site-header__cta { display: none; }
    .mobile-nav { display: block; position: relative; }
    .mobile-nav__toggle { width: 44px; height: 44px; display: grid; place-content: center; gap: 6px; border: 1px solid var(--color-border); background: rgba(247,244,239,.75); backdrop-filter: blur(12px); }
    .mobile-nav__toggle span { width: 18px; height: 1px; background: var(--color-text); transition: transform var(--transition-fast); }
    .mobile-nav__toggle[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .mobile-nav__toggle[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
    .mobile-nav__panel { position: absolute; right: 0; top: calc(100% + 10px); width: min(86vw, 360px); max-height: calc(100vh - 110px); overflow: auto; padding: 24px; gap: 18px; background: rgba(255,253,249,.97); border: 1px solid var(--color-border); box-shadow: var(--shadow-soft); backdrop-filter: blur(18px); }
    .mobile-nav__panel:not([hidden]) { display: grid; }
    .mobile-nav__panel a { min-height: 40px; display: flex; align-items: center; }
    .mobile-nav__panel a[aria-current="page"] { color: var(--color-accent-strong); }
    .mobile-nav__fallback { display: none; }
    :global(html:not(.js)) .mobile-nav__toggle { display: none; }
    :global(html:not(.js)) .mobile-nav__fallback {
      display: grid;
      position: absolute;
      right: 0;
      top: 100%;
      width: min(86vw, 360px);
      padding: 20px 24px;
      gap: 14px;
      background: rgba(255,253,249,.98);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-soft);
    }
    :global(html:not(.js)) .mobile-nav__fallback a { min-height: 40px; display: flex; align-items: center; }
    :global(html:not(.js)) .mobile-nav__fallback a[aria-current="page"] { color: var(--color-accent-strong); }
  }
</style>
