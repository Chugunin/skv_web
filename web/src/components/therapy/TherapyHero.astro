---
import Container from "@components/layout/Container.astro";
import Reveal from "@components/decorative/Reveal.astro";
import PaintStroke from "@components/decorative/PaintStroke.astro";
import GeometricFigure from "@components/decorative/GeometricFigure.astro";
---
<section class="therapy-hero">
  <Container>
    <div class="therapy-hero__grid">
      <Reveal class="therapy-hero__copy">
        <h1>SKV Therapy</h1>
        <p class="therapy-hero__lead">Работа с тем, как вы воспринимаете себя, свои отношения и происходящее вокруг.</p>
        <p class="therapy-hero__text">Психологическая работа, направленная на понимание внутренних процессов, изменение привычных сценариев и формирование большей внутренней устойчивости.</p>
      </Reveal>
      <Reveal class="therapy-hero__art" delay={100}>
        <PaintStroke src="/assets/reference/therapy-hero.webp" fit="cover" position="center" width={500} height={410} loading="eager" fetchpriority="high" />
        <GeometricFigure class="therapy-hero__geometry" size={280}/>
      </Reveal>
    </div>
  </Container>
</section>
<style>
.therapy-hero{padding:clamp(48px,6vw,92px) 0 clamp(80px,8vw,120px);position:relative}.therapy-hero__grid{display:grid;grid-template-columns:minmax(360px,.88fr) minmax(460px,1.12fr);gap:clamp(46px,6vw,96px);align-items:center}.therapy-hero__copy{max-width:620px}.therapy-hero h1{font-size:clamp(64px,7.4vw,118px);letter-spacing:-.035em;white-space:nowrap}.therapy-hero__lead{max-width:560px;margin-top:22px;font-size:clamp(17px,1.45vw,22px);line-height:1.55}.therapy-hero__text{max-width:565px;margin-top:34px;color:var(--color-muted);font-size:14px;line-height:1.8}.therapy-hero__art{position:relative;min-height:500px;margin-right:calc(var(--container-padding)*-1)}.therapy-hero__art :global(.paint-stroke),.therapy-hero__art :global(img){width:100%;height:100%}.therapy-hero__art :global(img){object-fit:cover}.therapy-hero__geometry{position:absolute;right:4%;top:-6%;z-index:2;opacity:.58}@media(max-width:980px){.therapy-hero__grid{grid-template-columns:1fr}.therapy-hero h1{white-space:normal}.therapy-hero__art{min-height:380px;margin-left:8%;}.therapy-hero__copy{max-width:720px}}@media(max-width:600px){.therapy-hero{padding-top:28px}.therapy-hero__art{min-height:300px;margin-left:0}.therapy-hero__geometry{width:170px;height:170px}.therapy-hero__text{margin-top:24px}}
</style>
