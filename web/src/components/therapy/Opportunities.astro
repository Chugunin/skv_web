---
import Container from "@components/layout/Container.astro";import Section from "@components/common/Section.astro";import SectionHeading from "@components/common/SectionHeading.astro";import Reveal from "@components/decorative/Reveal.astro";import PaintStroke from "@components/decorative/PaintStroke.astro";
const items=['лучше понимать себя и свои реакции','видеть причины повторяющихся сценариев','принимать более точные решения','выстраивать более качественные отношения','формировать внутреннюю устойчивость','по-новому взаимодействовать с собой и окружающим миром'];
---
<Section class="opportunities"><Container><div class="opportunities__grid"><Reveal><SectionHeading>Новые возможности</SectionHeading><p class="opportunities__intro">В процессе работы появляются новые возможности:</p><ul>{items.map(item=><li><span aria-hidden="true">✓</span>{item}</li>)}</ul></Reveal><Reveal class="opportunities__art" delay={90}><PaintStroke src="/assets/reference/therapy-opportunities.webp" fit="cover" position="center" width={356} height={240}/></Reveal></div></Container></Section>
<style>.opportunities{padding-block:55px 80px}.opportunities__grid{display:grid;grid-template-columns:1fr .78fr;gap:clamp(50px,8vw,130px);align-items:center}.opportunities__intro{margin-top:24px;font-size:14px}.opportunities ul{list-style:none;padding:0;margin:20px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:12px 28px}.opportunities li{display:flex;gap:10px;font-size:12px;line-height:1.55}.opportunities li span{color:var(--color-accent);font-weight:600}.opportunities__art{min-height:245px;margin-right:calc(var(--container-padding)*-1)}.opportunities__art :global(.paint-stroke),.opportunities__art :global(img){height:100%;width:100%}@media(max-width:800px){.opportunities__grid{grid-template-columns:1fr}.opportunities__art{min-height:190px;margin-right:calc(var(--container-padding)*-1)}}@media(max-width:520px){.opportunities ul{grid-template-columns:1fr}}
</style>
