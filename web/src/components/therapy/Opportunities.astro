---
import Container from "@components/layout/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import Reveal from "@components/decorative/Reveal.astro";
import PaintStroke from "@components/decorative/PaintStroke.astro";
import GeometricFigure from "@components/decorative/GeometricFigure.astro";
const items=["лучше понимать себя и свои реакции","видеть причины повторяющихся сценариев","принимать более точные решения","выстраивать более качественные отношения","формировать внутреннюю устойчивость","по-новому взаимодействовать с собой и окружающим миром"];
---
<section class="opportunities">
 <Container><div class="opportunities__grid"><Reveal><SectionHeading>Новые возможности</SectionHeading><p class="intro">В процессе работы появляются новые возможности:</p><ul>{items.map(item=><li>{item}</li>)}</ul></Reveal><Reveal class="opportunities__art" delay={100}><GeometricFigure class="opportunities__geometry" size={220}/><PaintStroke src="/assets/reference/therapy-opportunities.webp" class="opportunities__stroke" /></Reveal></div></Container>
</section>
<style>
.opportunities{padding-bottom:var(--section-space);overflow:hidden}.opportunities__grid{display:grid;grid-template-columns:1fr .8fr;gap:60px;align-items:center}.intro{margin-top:28px;font-size:13px;color:var(--color-muted)}ul{list-style:none;padding:0;margin:26px 0 0;display:grid;grid-template-columns:repeat(2,minmax(220px,1fr));gap:13px 38px}li{font-size:11px;color:var(--color-muted);padding-left:21px;position:relative}li::before{content:"✓";position:absolute;left:0;color:var(--color-accent);font-size:14px}.opportunities__art{position:relative;min-height:270px}.opportunities__stroke{position:absolute;inset:0 -10% 0 0}.opportunities__stroke :global(img){object-fit:cover!important}.opportunities__geometry{position:absolute;z-index:2;left:-14%;top:-15%}@media(max-width:900px){.opportunities__grid{grid-template-columns:1fr}.opportunities__art{min-height:230px}}@media(max-width:620px){ul{grid-template-columns:1fr}.opportunities__geometry{width:160px;height:160px}}
</style>
