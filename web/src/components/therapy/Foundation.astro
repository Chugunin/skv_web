---
import Container from "@components/layout/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import Reveal from "@components/decorative/Reveal.astro";
const steps=[
  ["01","Событие","✦"],["02","Восприятие","◉"],["03","Мысли","⌁"],["04","Эмоции","♡"],["05","Действия","→"],["06","Результат","◎"]
];
---
<section class="foundation" id="foundation">
  <Container>
    <div class="foundation__grid">
      <Reveal class="foundation__copy">
        <SectionHeading>Основа работы</SectionHeading>
        <p>Человек воспринимает жизнь через собственный опыт, убеждения и внутренние процессы.</p>
        <p>В работе SKV мы исследуем не только события и ситуации, но и то, как человек их воспринимает, какие реакции формируются и как это влияет на решения, отношения и качество жизни.</p>
      </Reveal>
      <Reveal class="foundation__flow" delay={100}>
        {steps.map(([num,title,icon],i)=><div class="foundation-step" style={`--i:${i}`}><span class="foundation-step__num">{num}</span><span class="foundation-step__icon" aria-hidden="true">{icon}</span><strong>{title}</strong></div>)}
      </Reveal>
    </div>
  </Container>
</section>
<style>
.foundation{padding:0 0 var(--section-space)}.foundation__grid{display:grid;grid-template-columns:minmax(300px,.72fr) minmax(620px,1.28fr);gap:clamp(48px,7vw,100px);align-items:end}.foundation__copy p{margin-top:26px;max-width:550px;color:var(--color-muted);font-size:14px;line-height:1.85}.foundation__flow{position:relative;display:grid;grid-template-columns:repeat(6,1fr);gap:0;padding-top:18px}.foundation__flow::before{content:"";position:absolute;left:8%;right:8%;top:76px;height:1px;background:var(--color-line)}.foundation-step{position:relative;z-index:1;text-align:center;display:grid;justify-items:center;gap:10px}.foundation-step__num{font-size:11px}.foundation-step__icon{width:58px;height:58px;border:1px solid var(--color-accent);border-radius:50%;display:grid;place-items:center;background:var(--color-background);color:var(--color-accent);font-family:Georgia,serif;font-size:23px}.foundation-step strong{font-size:11px;font-weight:600}@media(max-width:1080px){.foundation__grid{grid-template-columns:1fr}.foundation__flow{overflow-x:auto;grid-template-columns:repeat(6,minmax(110px,1fr));padding-bottom:10px}.foundation__flow::before{left:55px;right:55px}}@media(max-width:620px){.foundation__flow{margin-inline:calc(var(--container-padding)*-1);padding-inline:var(--container-padding)}.foundation__flow::before{left:calc(var(--container-padding) + 55px);right:calc(var(--container-padding) + 55px)}}
</style>
