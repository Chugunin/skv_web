---
import Container from "@components/layout/Container.astro";import Section from "@components/common/Section.astro";import SectionHeading from "@components/common/SectionHeading.astro";import Reveal from "@components/decorative/Reveal.astro";import LineIcon from "@components/common/LineIcon.astro";
const principles=[["target","Точность","Работаем глубоко и по существу."],["heart","Честность","Говорим прямо и бережно."],["lock","Конфиденциальность","Ваше доверие — наш приоритет."],["person","Уважение","Принимаем вашу уникальность."],["growth","Устойчивые изменения","Фокус на результате."]] as const;
---
<Section class="principles"><Container><Reveal class="principles__heading"><SectionHeading>Принципы работы</SectionHeading></Reveal><div class="principles__grid">{principles.map(([icon,title,text],index)=><Reveal class="principle" delay={index*70}><LineIcon name={icon}/><h3>{title}</h3><p>{text}</p></Reveal>)}</div></Container></Section>
<style>.principles{padding-top:clamp(50px,6vw,90px)}.principles__heading{display:flex;justify-content:center;margin-bottom:54px}.principles__grid{display:grid;grid-template-columns:repeat(5,1fr)}.principle{min-height:155px;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 clamp(14px,2vw,32px)}.principle+.principle{border-left:1px solid var(--color-line)}.principle :global(.line-icon){margin-bottom:18px}.principle h3{font-family:inherit;font-size:13px;font-weight:600;line-height:1.35}.principle p{max-width:180px;margin-top:10px;color:var(--color-muted);font-size:12px;line-height:1.6}@media(max-width:900px){.principles__grid{grid-template-columns:repeat(2,1fr);gap:34px 0}.principle:nth-child(odd){border-left:0}.principle{padding-bottom:20px}}@media(max-width:520px){.principles__grid{grid-template-columns:1fr}.principle+.principle{border-left:0;border-top:1px solid var(--color-line);padding-top:28px}}</style>
