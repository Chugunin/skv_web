---
import Container from "@components/layout/Container.astro";
import Section from "@components/common/Section.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import Reveal from "@components/decorative/Reveal.astro";
import PaintStroke from "@components/decorative/PaintStroke.astro";
import Button from "@components/common/Button.astro";
---
<Section id="contact" class="contact">
  <div class="contact__decor" aria-hidden="true"><PaintStroke src="/assets/reference/home-contact.webp" width={350} height={180}/></div>
  <Container>
    <Reveal class="contact__content">
      <SectionHeading>Связаться с SKV</SectionHeading>
      <p>Если хотите записаться на консультацию или узнать больше о проектах SKV, начнем с короткого диалога.</p>
      <Button variant="primary" data-contact-modal-open data-contact-source="home">Записаться на консультацию</Button>
    </Reveal>
  </Container>
</Section>
<style>
.contact{position:relative;padding-block:70px 88px;overflow:hidden}.contact__decor{position:absolute;right:-20px;bottom:-12px;width:min(38vw,480px);height:210px;opacity:.85}.contact__decor :global(.paint-stroke),.contact__decor :global(img){width:100%;height:100%;object-fit:cover;object-position:left center}.contact__content{position:relative;z-index:1;max-width:720px}.contact__content p{margin-top:28px;max-width:600px;font-size:clamp(14px,1.05vw,16px);line-height:1.75;color:var(--color-muted)}.contact__content :global(.button){margin-top:32px;border-radius:999px}@media(max-width:760px){.contact{padding-block:var(--section-space)}.contact__decor{opacity:.28;width:78vw}.contact__content p{margin-top:22px}.contact__content :global(.button){width:100%;max-width:360px}}</style>
