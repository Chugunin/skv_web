---
import Container from "@components/layout/Container.astro";import Section from "@components/common/Section.astro";import SectionHeading from "@components/common/SectionHeading.astro";import Reveal from "@components/decorative/Reveal.astro";import ContactForm from "@components/forms/ContactForm.astro";import PaintStroke from "@components/decorative/PaintStroke.astro";
---
<Section id="contact" class="contact"><div class="contact__decor" aria-hidden="true"><PaintStroke src="/assets/reference/home-contact.webp" width={350} height={180}/></div><Container><div class="contact__grid"><Reveal class="contact__copy"><SectionHeading>Связаться с SKV</SectionHeading><p>Оставьте заявку, если хотите записаться на консультацию или узнать больше о проектах SKV.</p></Reveal><Reveal class="contact__form" delay={90}><ContactForm/></Reveal></div></Container></Section>
<style>.contact{position:relative;padding-block:70px 88px;overflow:hidden}.contact__decor{position:absolute;right:-20px;bottom:-12px;width:min(38vw,480px);height:210px;opacity:.85}.contact__decor :global(.paint-stroke),.contact__decor :global(img){width:100%;height:100%;object-fit:cover;object-position:left center}.contact__grid{position:relative;z-index:1;display:grid;grid-template-columns:.8fr 1.2fr;align-items:start;gap:clamp(55px,9vw,145px)}.contact__copy{max-width:470px}.contact__copy p{margin-top:28px;font-size:clamp(14px,1.05vw,16px);line-height:1.75}.contact__form{max-width:630px}@media(max-width:760px){.contact{padding-block:var(--section-space)}.contact__grid{grid-template-columns:1fr;gap:40px}.contact__copy{max-width:620px}.contact__decor{opacity:.28;width:78vw}}</style>
