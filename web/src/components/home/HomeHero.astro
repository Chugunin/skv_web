---
import Container from "@components/layout/Container.astro";import Button from "@components/common/Button.astro";import Reveal from "@components/decorative/Reveal.astro";import PaintStroke from "@components/decorative/PaintStroke.astro";import GeometricFigure from "@components/decorative/GeometricFigure.astro";
---
<section class="home-hero" aria-labelledby="home-title"><Container><div class="home-hero__grid"><Reveal class="home-hero__content"><h1 id="home-title">SKV</h1><p class="home-hero__lead">психология восприятия<br/>и качества жизни</p><div class="home-hero__actions"><Button href="#about" variant="text">О SKV</Button><Button href="#directions" variant="text">Смотреть направления</Button></div></Reveal><Reveal class="home-hero__art" delay={100}><GeometricFigure class="home-hero__geometry" size={285}/><PaintStroke src="/assets/reference/home-hero.webp" class="home-hero__stroke" width={585} height={410} loading="eager" fetchpriority="high"/></Reveal></div></Container></section>
<style>.home-hero{min-height:clamp(650px,78vh,900px);display:flex;align-items:center;padding:clamp(42px,6vw,92px) 0 clamp(70px,8vw,120px);overflow:hidden}.home-hero__grid{display:grid;grid-template-columns:minmax(300px,.74fr) minmax(520px,1.26fr);align-items:center;min-height:580px}.home-hero__content{position:relative;z-index:2}.home-hero h1{font-size:clamp(104px,14vw,205px);font-weight:400;letter-spacing:-.055em;line-height:.72}.home-hero__lead{margin-top:34px;font-size:clamp(20px,2.05vw,29px);line-height:1.28}.home-hero__actions{margin-top:56px;width:min(270px,100%);display:grid;gap:2px}.home-hero__actions :global(.button){border-bottom:1px solid var(--color-accent);padding-block:8px;font-size:12px;color:var(--color-text)}.home-hero__art{position:relative;height:100%;min-height:520px;margin-right:calc(var(--container-padding)*-1)}.home-hero__stroke{position:absolute;inset:5% 0 0 -12%}.home-hero__stroke :global(img){object-fit:contain;object-position:right center}.home-hero__geometry{position:absolute;left:6%;top:0;z-index:2}@media(max-width:900px){.home-hero{min-height:auto;padding-top:45px}.home-hero__grid{grid-template-columns:1fr;min-height:0}.home-hero h1{font-size:clamp(92px,27vw,150px)}.home-hero__lead{margin-top:26px;font-size:20px}.home-hero__actions{margin-top:38px}.home-hero__art{min-height:360px;margin:20px calc(var(--container-padding)*-1) 0 5%}.home-hero__geometry{width:180px;height:180px}}</style>
