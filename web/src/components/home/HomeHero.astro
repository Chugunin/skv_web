---
import Container from "@components/layout/Container.astro";
import Button from "@components/common/Button.astro";
import Reveal from "@components/decorative/Reveal.astro";
import BrushComposition from "@components/decorative/BrushComposition.astro";

const heroStrokes = [
  {
    src: "/assets/strokes/home/hero-01.png",
    direction: "lt" as const,
    left: 10,
    top: 11,
    width: 72,
    zIndex: 1,
    delay: 0,
    duration: 1500,
    fetchpriority: "high" as const
  },
  {
    src: "/assets/strokes/home/hero-02.png",
    direction: "lt" as const,
    left: 5,
    top: 28,
    width: 68,
    zIndex: 2,
    delay: 1000,
    duration: 1500
  },
  {
    src: "/assets/strokes/home/hero-03.png",
    direction: "rt" as const,
    left: 18,
    top: 25.5,
    width: 69,
    zIndex: 3,
    delay: 2000,
    duration: 1500
  },
  {
    src: "/assets/strokes/home/hero-04.png",
    direction: "rt" as const,
    left: 13,
    top: 49,
    width: 71,
    zIndex: 4,
    delay: 3000,
    duration: 1500
  },
  {
    src: "/assets/strokes/home/hero-05.png",
    direction: "rt" as const,
    left: 17,
    top: 66,
    width: 78,
    zIndex: 5,
    delay: 4000,
    duration: 1500
  }
];
---
<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__brush-layer" aria-hidden="true">
    <BrushComposition strokes={heroStrokes} class="home-hero__brushes" />
  </div>

  <Container>
    <div class="home-hero__grid">
      <Reveal class="home-hero__content">
        <h1 id="home-title">SKV</h1>
        <p class="home-hero__lead">психология восприятия<br/>и качества жизни</p>
        <div class="home-hero__actions">
          <Button href="#about" variant="text">О SKV</Button>
          <Button href="#directions" variant="text">Смотреть направления</Button>
        </div>
      </Reveal>
    </div>
  </Container>
</section>

<style>
  .home-hero {
    min-height: clamp(650px, 78vh, 900px);
    display: flex;
    align-items: center;
    padding: clamp(42px, 6vw, 92px) 0 clamp(70px, 8vw, 120px);
    position: relative;
    isolation: isolate;
    overflow: visible;
  }

  .home-hero__brush-layer {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: -8px;
    width: clamp(280px, 34vw, 360px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .home-hero__brushes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .home-hero :global(.container) {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(300px, .74fr) minmax(520px, 1.26fr);
    align-items: center;
    min-height: 580px;
  }

  .home-hero__content {
    position: relative;
    z-index: 2;
  }

  .home-hero h1 {
    font-size: clamp(104px, 14vw, 205px);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: .72;
  }

  .home-hero__lead {
    margin-top: 34px;
    font-size: clamp(20px, 2.05vw, 29px);
    line-height: 1.28;
  }

  .home-hero__actions {
    margin-top: 56px;
    width: min(270px, 100%);
    display: grid;
    gap: 2px;
  }

  .home-hero__actions :global(.button) {
    border-bottom: 1px solid var(--color-accent);
    padding-block: 8px;
    font-size: 12px;
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .home-hero {
      min-height: auto;
      padding-top: 45px;
    }

    .home-hero__grid {
      grid-template-columns: 1fr;
      min-height: 580px;
    }

    .home-hero h1 {
      font-size: clamp(92px, 27vw, 150px);
    }

    .home-hero__lead {
      margin-top: 26px;
      font-size: 20px;
    }

    .home-hero__actions {
      margin-top: 38px;
    }
  }

  @media (max-width: 560px) {
    .home-hero__grid {
      min-height: 520px;
    }
  }
</style>
