---
import Container from "@components/layout/Container.astro";import Section from "@components/common/Section.astro";import SectionHeading from "@components/common/SectionHeading.astro";import Reveal from "@components/decorative/Reveal.astro";
const directions=[{title:"SKV Therapy",text:"Индивидуальная психологическая работа и консультирование.",href:"/therapy/",cta:"Перейти к консультации",mod:"therapy"},{title:"SKV Practice",text:"Практические материалы и инструменты для самостоятельной работы с мышлением, эмоциями и состоянием.",href:"/practice/",cta:"Смотреть продукты",mod:"practice"},{title:"SKV Journal",text:"Интеллектуальная библиотека.",href:"/journal/",cta:"Читать журнал",mod:"journal"}];
---
<Section id="directions" class="directions"><Container><Reveal class="directions__heading"><SectionHeading>Направления SKV</SectionHeading></Reveal><div class="directions__grid">{directions.map((item,index)=><Reveal as="article" class={`direction direction--${item.mod}`} delay={index*90}><div class="direction__wash" aria-hidden="true"></div><div class="direction__content"><h3>{item.title}</h3><p>{item.text}</p><a href={item.href}>{item.cta}<span aria-hidden="true">→</span></a></div></Reveal>)}</div></Container></Section>
<style>.directions{padding-top:44px}.directions__heading{display:flex;justify-content:center;margin-bottom:38px}.directions__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.direction{min-height:310px;position:relative;overflow:hidden;border:1px solid var(--color-border);background:rgba(255,255,255,.36);box-shadow:0 10px 30px rgba(23,22,20,.035)}.direction__wash{position:absolute;inset:0;background-image:url('/assets/reference/home-about.webp');background-size:cover;background-position:center;opacity:.64;transform:scale(1.05)}.direction--therapy .direction__wash{background-image:url('/assets/reference/home-hero.webp');background-position:80% center}.direction--practice .direction__wash{filter:saturate(.55) brightness(1.16);background-position:30% center}.direction--journal .direction__wash{background-image:url('/assets/reference/home-hero.webp');background-position:55% center;filter:hue-rotate(25deg) saturate(.65) brightness(1.1)}.direction:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(247,244,239,.96),rgba(247,244,239,.88) 48%,rgba(247,244,239,.08))}.direction__content{position:relative;z-index:1;height:100%;padding:42px 28px 24px;display:flex;flex-direction:column;align-items:flex-start}.direction h3{font-size:clamp(31px,3vw,44px);font-weight:500}.direction p{max-width:255px;margin-top:18px;font-size:13px;line-height:1.7}.direction a{margin-top:auto;display:flex;align-items:center;gap:18px;font-size:12px;border-bottom:1px solid var(--color-line);padding-bottom:5px}.direction a span{color:var(--color-accent);font-size:20px}@media(max-width:860px){.directions{padding-top:0}.directions__grid{grid-template-columns:1fr;gap:14px}.direction{min-height:245px}.direction__content{padding:34px 26px 24px}.direction p{max-width:360px}}</style>
