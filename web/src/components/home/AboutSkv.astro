---
import Container from "@components/layout/Container.astro";import Section from "@components/common/Section.astro";import SectionHeading from "@components/common/SectionHeading.astro";import Reveal from "@components/decorative/Reveal.astro";import PaintStroke from "@components/decorative/PaintStroke.astro";
---
<Section id="about" class="about-skv"><Container><div class="about-skv__grid"><Reveal class="about-skv__copy"><SectionHeading>О SKV</SectionHeading><p>SKV — экосистема восприятия и качества жизни.</p><p>Работа, основанная на клинической психологии и системном анализе внутренних процессов.</p><p>Направлена на формирование ясности, внутренней устойчивости и более точного понимания себя и окружающей реальности.</p></Reveal><Reveal class="about-skv__art" delay={100}><PaintStroke src="/assets/reference/home-about.webp"/></Reveal></div></Container></Section>
<style>.about-skv{padding-top:0}.about-skv__grid{display:grid;grid-template-columns:minmax(300px,.72fr) minmax(440px,1.28fr);align-items:center;gap:clamp(50px,8vw,130px)}.about-skv__copy{max-width:530px}.about-skv__copy :global(.section-heading){margin-bottom:28px}.about-skv__copy p{font-size:15px;line-height:1.75}.about-skv__copy p+p{margin-top:8px}.about-skv__art{min-height:280px;margin-right:calc(var(--container-padding)*-1)}.about-skv__art :global(.paint-stroke){height:100%}.about-skv__art :global(img){object-fit:cover;object-position:left center}@media(max-width:800px){.about-skv__grid{grid-template-columns:1fr}.about-skv__art{min-height:210px;margin-right:calc(var(--container-padding)*-1)}}</style>
