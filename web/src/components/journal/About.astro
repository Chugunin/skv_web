---
import Container from "@components/layout/Container.astro";
import Reveal from "@components/decorative/Reveal.astro";
import GeometricFigure from "@components/decorative/GeometricFigure.astro";
---
<section class="journal-about">
  <Container>
    <div class="journal-about__grid">
      <Reveal class="journal-about__art"><GeometricFigure size={245}/></Reveal>
      <Reveal class="journal-about__copy" delay={100}>
        <h2>О журнале</h2>
        <p>SKV Journal объединяет экспертные материалы о том, как формируется наше восприятие, почему мы реагируем определенным образом и какие процессы влияют на качество жизни.</p>
      </Reveal>
    </div>
  </Container>
</section>
<style>
.journal-about{padding:10px 0 var(--section-space)}.journal-about__grid{display:grid;grid-template-columns:.75fr 1.25fr;align-items:center;gap:60px}.journal-about__art{display:grid;place-items:center;min-height:210px}.journal-about__copy{border-left:1px solid var(--color-accent);padding:10px 0 10px 38px;max-width:720px}.journal-about h2{font-size:clamp(46px,5vw,72px)}.journal-about p{margin-top:24px;color:var(--color-muted);max-width:650px;font-size:clamp(14px,1.05vw,16px);line-height:1.82}@media(max-width:760px){.journal-about{padding-top:0}.journal-about__grid{grid-template-columns:1fr}.journal-about__art{display:none}.journal-about__copy{padding-left:20px}}
</style>
