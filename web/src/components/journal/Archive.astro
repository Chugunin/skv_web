---
import Container from "@components/layout/Container.astro";
import Reveal from "@components/decorative/Reveal.astro";
import ArticleCard from "@components/article/ArticleCard.astro";
import { getArchive } from "@lib/repository";

const articles = await getArchive();
const categories = Array.from(
  new Map(
    articles
      .filter(article => article.category)
      .map(article => [article.category!.slug, article.category!])
  ).values()
);
---
<section id="archive" class="archive" data-archive aria-labelledby="archive-title">
 <Container>
  <Reveal class="archive__heading"><h2 id="archive-title">Архив материалов</h2></Reveal>
  {categories.length > 0 && <Reveal class="archive__filters" delay={60}>
   <div class="archive__filter-group" role="group" aria-label="Фильтр статей по категории">
    <button type="button" class="is-active" data-filter="all" aria-pressed="true">Все</button>
    {categories.map(c=><button type="button" data-filter={c.slug} aria-pressed="false">{c.title}</button>)}
   </div>
  </Reveal>}
  <div class="archive__grid" data-archive-grid>
   {articles.map((article,i)=><Reveal as="article" class="archive-item" delay={(i%4)*45}><div data-category={article.category?.slug ?? ""}><ArticleCard article={article} compact /></div></Reveal>)}
  </div>
  {articles.length === 0
    ? <p class="archive__empty">Материалы готовятся к публикации.</p>
    : <p class="archive__empty" data-archive-empty aria-live="polite" hidden>В этой категории пока нет опубликованных материалов.</p>}
 </Container>
</section>
<script>
  const archive = document.querySelector<HTMLElement>('[data-archive]');
  const buttons = archive?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? [];
  const cards = archive?.querySelectorAll<HTMLElement>('[data-archive-grid] [data-category]') ?? [];
  const empty = archive?.querySelector<HTMLElement>('[data-archive-empty]');

  buttons.forEach(button => button.addEventListener('click', () => {
    const filter = button.dataset.filter ?? 'all';
    buttons.forEach(item => {
      const active = item === button;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-pressed', String(active));
    });

    let visible = 0;
    cards.forEach(card => {
      const show = filter === 'all' || card.dataset.category === filter;
      const item = card.closest<HTMLElement>('.archive-item');
      if (item) item.hidden = !show;
      if (show) visible += 1;
    });
    if (empty) empty.hidden = visible > 0;
  }));
</script>
<style>
.archive{padding-bottom:var(--section-space);position:relative}.archive__heading{text-align:center}.archive h2{font-size:clamp(44px,4.7vw,68px)}.archive__filters{margin:26px auto 34px}.archive__filter-group{display:flex;justify-content:center;flex-wrap:wrap;gap:10px}.archive__filters button{min-height:38px;padding:8px 19px;border:1px solid var(--color-accent);border-radius:999px;background:transparent;font-size:11px;line-height:1;cursor:pointer;transition:background var(--transition-fast),color var(--transition-fast),border-color var(--transition-fast),transform var(--transition-fast)}.archive__filters button.is-active,.archive__filters button:hover{background:#2d2b29;color:#fff;border-color:#2d2b29}.archive__filters button:active{transform:translateY(1px)}.archive__filters button:focus-visible{outline:2px solid var(--color-accent-strong);outline-offset:3px}.archive__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.archive-item{min-width:0}.archive-item[hidden]{display:none}.archive__empty{text-align:center;padding:48px 0;color:var(--color-muted);font-size:13px}@media(max-width:900px){.archive__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.archive__grid{grid-template-columns:1fr}.archive__filters{overflow-x:auto;scrollbar-width:none;margin-inline:calc(var(--container-padding)*-1);padding:3px var(--container-padding) 7px;overscroll-behavior-inline:contain}.archive__filters::-webkit-scrollbar{display:none}.archive__filter-group{justify-content:flex-start;flex-wrap:nowrap;width:max-content}.archive__filters button{white-space:nowrap}}
:global(html:not(.js)) .archive__filters{display:none}
</style>
