---
import Container from "@components/layout/Container.astro";
import Button from "@components/common/Button.astro";
import Reveal from "@components/decorative/Reveal.astro";
import PaintStroke from "@components/decorative/PaintStroke.astro";
import GeometricFigure from "@components/decorative/GeometricFigure.astro";
---
<section class="journal-hero" aria-labelledby="journal-title">
  <Container>
    <div class="journal-hero__grid">
      <Reveal class="journal-hero__content">
        <h1 id="journal-title">SKV Journal</h1>
        <p class="journal-hero__eyebrow">Статьи и исследования о психологии,<br />восприятии и качестве жизни</p>
        <p class="journal-hero__text">Материалы SKV о внутренних процессах человека, отношениях и способах лучше понимать себя и окружающий мир.</p>
        <Button href="#articles" variant="outline">Смотреть материалы</Button>
      </Reveal>
      <Reveal class="journal-hero__art" delay={100}>
        <GeometricFigure class="journal-hero__geometry" size={285}/>
        <PaintStroke src="/assets/reference/journal-hero.webp" class="journal-hero__stroke" />
      </Reveal>
    </div>
  </Container>
</section>
<style>
.journal-hero{padding:clamp(58px,7vw,105px) 0 clamp(80px,8vw,122px);overflow:hidden}.journal-hero__grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(40px,6vw,90px);align-items:center}.journal-hero h1{font-size:clamp(78px,9.5vw,145px);font-weight:400;letter-spacing:-.05em}.journal-hero__eyebrow{margin-top:22px;text-transform:uppercase;letter-spacing:.04em;font-size:14px;line-height:1.55}.journal-hero__text{margin:28px 0 34px;max-width:560px;color:var(--color-muted);font-size:14px;line-height:1.8}.journal-hero__content :global(.button){min-width:240px}.journal-hero__art{position:relative;min-height:440px}.journal-hero__stroke{position:absolute;inset:0 -5% 0 0}.journal-hero__stroke :global(img){object-fit:cover!important}.journal-hero__geometry{position:absolute;z-index:2;left:6%;top:-12%}@media(max-width:900px){.journal-hero__grid{grid-template-columns:1fr}.journal-hero__art{order:-1;min-height:360px}}@media(max-width:620px){.journal-hero__art{min-height:280px}.journal-hero__geometry{width:170px;height:170px}.journal-hero__eyebrow br{display:none}}
</style>
