---
import Container from "@components/layout/Container.astro";
import SectionHeading from "@components/common/SectionHeading.astro";
import Reveal from "@components/decorative/Reveal.astro";
import { getDirections } from "@lib/repository";

const directions = await getDirections();
---
<section class="journal-directions">
  <Container>
    <Reveal class="journal-directions__heading"><SectionHeading>Направления исследований</SectionHeading></Reveal>
    <div class="journal-directions__grid">
      {directions.map((direction, i) =>
        <Reveal as="article" class="direction" delay={i * 40}>
          <span aria-hidden="true">{direction.icon || "·"}</span>
          <h3>{direction.title}</h3>
          <p>{direction.description}</p>
        </Reveal>
      )}
    </div>
  </Container>
</section>
<style>
.journal-directions{padding-bottom:var(--section-space)}
.journal-directions__heading{text-align:center}
.journal-directions__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:42px;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}
.direction{min-width:0;text-align:left;padding:28px 30px 30px;border-right:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}
.direction:nth-child(3n){border-right:0}
.direction:nth-last-child(-n+3){border-bottom:0}
.direction>span{display:block;color:var(--color-accent);font-size:31px;line-height:1}
.direction h3{margin-top:16px;font-family:Manrope,sans-serif;font-size:13px;line-height:1.45;font-weight:600}
.direction p{margin-top:10px;max-width:320px;color:var(--color-muted);font-size:12px;line-height:1.65}
@media(max-width:760px){.journal-directions__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.direction:nth-child(3n){border-right:1px solid var(--color-border)}.direction:nth-child(2n){border-right:0}.direction:nth-last-child(-n+3){border-bottom:1px solid var(--color-border)}.direction:nth-last-child(-n+2){border-bottom:0}}
@media(max-width:480px){.journal-directions__grid{grid-template-columns:1fr}.direction,.direction:nth-child(3n),.direction:nth-child(2n){border-right:0;border-bottom:1px solid var(--color-border);padding-inline:18px}.direction:nth-last-child(-n+2){border-bottom:1px solid var(--color-border)}.direction:last-child{border-bottom:0}}
</style>
