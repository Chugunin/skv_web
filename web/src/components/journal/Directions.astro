---
const directions = [

    {
        title:"Восприятие",
        description:"Как человек воспринимает себя и окружающий мир.",
        image:"https://picsum.photos/600/600?1"
    },

    {
        title:"Мышление",
        description:"Убеждения и установки, когнитивные процессы.",
        image:"https://picsum.photos/600/600?2"
    },

    {
        title:"Эмоции",
        description:"Внутренние состояния и способы реагирования.",
        image:"https://picsum.photos/600/600?3"
    },

    {
        title:"Отношения",
        description:"Близость, границы и взаимодействие.",
        image:"https://picsum.photos/600/600?4"
    },

    {
        title:"Личность",
        description:"Особенности характера и внутренней организации.",
        image:"https://picsum.photos/600/600?5"
    },

    {
        title:"Качество жизни",
        description:"Осознанность, выборы и устойчивость.",
        image:"https://picsum.photos/600/600?6"
    }

];
---

<section class="directions" data-reveal>

    <div class="container">

        <h2>

            Аналитика и исследования

        </h2>

        <div class="grid">

            {

                directions.map(item => (

                        <article class="card">

                            <img
                                    src={item.image}
                                    alt={item.title}
                            />

                            <div class="overlay">

                                <h3>

                                    {item.title}

                                </h3>

                                <p>

                                    {item.description}

                                </p>

                            </div>

                        </article>

                ))

            }

        </div>

    </div>

</section>

<style>

    .directions{

        background:var(--color-dark);

        padding:110px 0;

    }

    .container{

        width:min(
                calc(100% - var(--container-padding) * 2),
                var(--container-width)
        );

        margin-inline:auto;

    }

    .directions h2{

        color:white;

        text-align:center;

        margin-bottom:70px;

        font-weight:300;

    }

    .grid{

        display:grid;

        grid-template-columns:repeat(3,1fr);

        gap:24px;

    }

    .card{

        position:relative;

        overflow:hidden;

        border-radius:6px;

        min-height:260px;

        cursor:pointer;

    }

    .card img{

        position:absolute;

        inset:0;

        width:100%;

        height:100%;

        object-fit:cover;

        transition:transform .5s;

    }

    .card::before{

        content:"";

        position:absolute;

        inset:0;

        background:linear-gradient(
                to top,
                rgba(0,0,0,.65),
                rgba(0,0,0,.15)
        );

        z-index:1;

    }

    .overlay{

        position:absolute;

        inset:0;

        z-index:2;

        padding:28px;

        display:flex;

        flex-direction:column;

        justify-content:space-between;

        color:white;

    }

    .overlay h3{

        font-size:24px;

        font-weight:300;

    }

    .overlay p{

        font-size:16px;

        line-height:1.5;

        opacity:.95;

    }

    .card:hover img{

        transform:scale(1.06);

    }

    @media(max-width:960px){

        .grid{

            grid-template-columns:1fr;

        }

    }

</style>