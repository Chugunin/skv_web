---
import Container from "@components/layout/Container.astro";
import Reveal from "@components/decorative/Reveal.astro";
import ContactForm from "@components/forms/ContactForm.astro";
import PaintStroke from "@components/decorative/PaintStroke.astro";
---
<section class="journal-contact" id="journal-contact">
 <Container><div class="journal-contact__grid"><Reveal><h2>Связаться с SKV</h2><p>Оставьте заявку, если хотите записаться на консультацию или узнать больше о проектах SKV.</p></Reveal><Reveal class="journal-contact__form" delay={80}><ContactForm /></Reveal></div></Container>
 <PaintStroke src="/assets/reference/journal-contact.webp" class="journal-contact__art" />
</section>
<style>
.journal-contact{position:relative;padding:clamp(70px,8vw,120px) 0;overflow:hidden;border-top:1px solid var(--color-border)}.journal-contact__grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(50px,8vw,120px);align-items:center;position:relative;z-index:1}.journal-contact h2{font-size:clamp(48px,5vw,72px)}.journal-contact p{margin-top:25px;max-width:470px;color:var(--color-muted);font-size:13px;line-height:1.8}.journal-contact__art{position:absolute;width:280px;height:260px;right:-45px;bottom:-25px;opacity:.9}@media(max-width:830px){.journal-contact__grid{grid-template-columns:1fr}.journal-contact__art{opacity:.25}}
</style>
