---
import Container from "../layout/Container.astro";
---

<section class="subscribe" data-reveal>

    <Container>

        <div class="box">

            <h2>

                Подписаться на новые публикации

            </h2>

            <p>

                Получайте новые исследования и статьи сразу после публикации.

            </p>

            <form>

                <label>
                    <input
                            type="email"
                            placeholder="Ваш Email"
                    />
                </label>

                <button>

                    Подписаться

                </button>

            </form>

        </div>

    </Container>

</section>

<style>

    .subscribe{

        background:#F5F1EB;

        padding:140px 0;

    }

    .box{

        background:white;

        padding:90px;

        border-radius:10px;

        text-align:center;

    }

    .box h2{

        font-size:48px;

        font-weight:300;

        margin-bottom:20px;

    }

    .box p{

        font-size:18px;

        color:#666;

        margin-bottom:50px;

    }

    form{

        display:flex;

        justify-content:center;

        gap:20px;

        flex-wrap:wrap;

    }

    input{

        width:420px;

        height:60px;

        border:1px solid #ddd;

        padding:0 20px;

        font-size:17px;

    }

    button{

        height:60px;

        padding:0 42px;

        background:black;

        color:white;

        transition:.3s;

    }

    button:hover{

        background:#2d2d2d;

    }

    @media(max-width:900px){

        .box{

            padding:45px;

        }

        input{

            width:100%;

        }

        button{

            width:100%;

        }

    }

</style>