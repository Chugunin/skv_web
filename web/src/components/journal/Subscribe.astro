---
import Container from "@components/layout/Container.astro";import Section from "@components/common/Section.astro";import SectionHeading from "@components/common/SectionHeading.astro";import Reveal from "@components/decorative/Reveal.astro";import GeometricFigure from "@components/decorative/GeometricFigure.astro";
---
<Section class="subscribe"><GeometricFigure class="subscribe__figure" size={190}/><Container><Reveal class="subscribe__box"><SectionHeading>Оставайтесь в пространстве SKV</SectionHeading><p>Получайте новые материалы о психологии восприятия, внутренних процессах и качестве жизни.</p><div class="subscribe__actions" aria-label="Каналы будущей подписки"><span>Telegram</span><span>Email</span></div><small>Подписка будет доступна позже.</small></Reveal></Container></Section>
<style>.subscribe{padding-block:45px 85px;overflow:hidden}.subscribe__box{max-width:760px;margin:auto;text-align:center}.subscribe__box :global(.section-heading)::after{margin-inline:auto}.subscribe__box p{max-width:620px;margin:24px auto 0;font-size:14px;line-height:1.75;color:var(--color-muted)}.subscribe__actions{display:flex;justify-content:center;gap:10px;margin-top:28px}.subscribe__actions span{border:1px solid var(--color-accent);padding:10px 26px;font-size:11px;opacity:.55}.subscribe small{display:block;margin-top:12px;color:var(--color-muted);font-size:9px}.subscribe__figure{position:absolute;left:-45px;bottom:-20px;opacity:.3}</style>
