---
import Container from "@components/layout/Container.astro";
import Reveal from "@components/decorative/Reveal.astro";
import { getFeaturedPosts } from "@lib/repository";
import { formatDate } from "@lib/utils";
const posts=(await getFeaturedPosts()).slice(0,3);
---
<section id="articles" class="featured">
  <Container>
    <Reveal class="featured__header"><h2>Актуальные материалы</h2><a href="#archive">Читать все статьи <span aria-hidden="true">→</span></a></Reveal>
    <div class="featured__cards">{posts.map((post,i)=><Reveal delay={i*60}><a class="featured-card" href={`/journal/${post.slug}/`}><img src={post.image} alt="" loading="lazy" decoding="async"/><div class="featured-card__body"><span class="featured-card__category">{post.category?.title}</span><h3>{post.title}</h3><time datetime={post.date}>{formatDate(post.date)}</time></div></a></Reveal>)}</div>
  </Container>
</section>
<style>
.featured{padding-bottom:var(--section-space)}.featured__header{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:34px}.featured h2{font-size:clamp(44px,4.5vw,64px)}.featured__header>a{font-size:12px;color:var(--color-accent-strong);border-bottom:1px solid var(--color-line);padding-bottom:5px}.featured__cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.featured-card{display:block;background:#2c2a28;color:#fff;overflow:hidden;min-height:100%}.featured-card img{width:100%;aspect-ratio:1.55/1;object-fit:cover;filter:saturate(.72)}.featured-card__body{padding:18px 20px 20px;min-height:170px;display:flex;flex-direction:column}.featured-card__category{font-size:10px;text-transform:uppercase;color:#d1a96e;letter-spacing:.05em}.featured-card h3{margin-top:10px;font-family:Manrope,sans-serif;font-size:14px;line-height:1.5;font-weight:500}.featured-card time{margin-top:auto;padding-top:20px;font-size:10px;color:rgba(255,255,255,.72)}@media(max-width:820px){.featured__cards{grid-template-columns:1fr}.featured-card{display:grid;grid-template-columns:.9fr 1.1fr}.featured-card img{height:100%;aspect-ratio:auto}}@media(max-width:560px){.featured-card{display:block}.featured__header{align-items:flex-start;flex-direction:column}}
</style>
