---
import Container from "../layout/Container.astro";
import { getFeaturedPosts } from "@lib/repository.ts";

const posts = await getFeaturedPosts();
---

<section
        id="articles"
        class="featured"
        data-reveal
>

    <Container>

        <h2>

            Актуальные статьи

        </h2>

        <div class="cards">

            {

                posts.map(post => (

                        <article class="card">

                            <img
                                    src={post.image}
                                    alt=""
                            />

                            <div class="content">

                                <h3>

                                    {post.title}

                                </h3>

                                <p>

                                    {post.description}

                                </p>

                                <span>

                                {post.date}

                            </span>

                            </div>

                        </article>

                ))

            }

        </div>

    </Container>

</section>

<style>

    .featured{

        background:#F6F2EC;

        padding:120px 0;

    }

    .featured h2{

        text-align:center;

        font-weight:300;

        margin-bottom:70px;

    }

    .cards{

        display:grid;

        grid-template-columns:repeat(3,1fr);

        gap:32px;

    }

    .card{

        background:#3B3735;

        border-radius:8px;

        overflow:hidden;

        transition:
                transform .35s,
                box-shadow .35s;

    }

    .card:hover{

        transform:translateY(-8px);

        box-shadow:0 18px 45px rgba(0,0,0,.18);

    }

    .card img{

        width:100%;

        height:260px;

        object-fit:cover;

    }

    .content{

        padding:26px;

        color:white;

    }

    .content h3{

        font-size:22px;

        font-weight:300;

        margin-bottom:18px;

    }

    .content p{

        opacity:.85;

        line-height:1.6;

        margin-bottom:22px;

    }

    .content span{

        font-size:14px;

        opacity:.7;

    }

    @media(max-width:960px){

        .cards{

            grid-template-columns:1fr;

        }

    }

</style>