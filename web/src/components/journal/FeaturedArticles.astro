---
const posts = [

    {
        title:"A September Market of Ceramics, Jewelry, and Cosmetics",
        description:"Wood, handmade ceramics and other interesting things.",
        date:"03.07.2026 15:39",
        image:"https://picsum.photos/900/600?11"
    },

    {
        title:"Exploring the Main Event of the Literary Market",
        description:"The most important event of the literary market.",
        date:"03.07.2026 15:39",
        image:"https://picsum.photos/900/600?12"
    },

    {
        title:"Kids Sports",
        description:"Classes are available in the district.",
        date:"03.07.2026 15:39",
        image:"https://picsum.photos/900/600?13"
    }

];
---

<section
        id="articles"
        class="featured"
>

    <div class="container">

        <h2>

            Актуальные статьи

        </h2>

        <div class="cards">

            {

                posts.map(post => (

                        <article class="card">

                            <img
                                    src={post.image}
                                    alt=""
                            />

                            <div class="content">

                                <h3>

                                    {post.title}

                                </h3>

                                <p>

                                    {post.description}

                                </p>

                                <span>

                                {post.date}

                            </span>

                            </div>

                        </article>

                ))

            }

        </div>

    </div>

</section>

<style>

    .featured{

        background:#F6F2EC;

        padding:120px 0;

    }

    .container{

        width:min(
                calc(100% - var(--container-padding)*2),
                var(--container-width)
        );

        margin-inline:auto;

    }

    .featured h2{

        text-align:center;

        font-weight:300;

        margin-bottom:70px;

    }

    .cards{

        display:grid;

        grid-template-columns:repeat(3,1fr);

        gap:32px;

    }

    .card{

        background:#3B3735;

        border-radius:8px;

        overflow:hidden;

        transition:
                transform .35s,
                box-shadow .35s;

    }

    .card:hover{

        transform:translateY(-8px);

        box-shadow:0 18px 45px rgba(0,0,0,.18);

    }

    .card img{

        width:100%;

        height:260px;

        object-fit:cover;

    }

    .content{

        padding:26px;

        color:white;

    }

    .content h3{

        font-size:22px;

        font-weight:300;

        margin-bottom:18px;

    }

    .content p{

        opacity:.85;

        line-height:1.6;

        margin-bottom:22px;

    }

    .content span{

        font-size:14px;

        opacity:.7;

    }

    @media(max-width:960px){

        .cards{

            grid-template-columns:1fr;

        }

    }

</style>