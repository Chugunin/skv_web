---
import Container from "@components/layout/Container.astro";
import Reveal from "@components/decorative/Reveal.astro";
import ArticleCard from "@components/article/ArticleCard.astro";
import { getFeaturedPosts } from "@lib/repository";
const posts = (await getFeaturedPosts()).slice(0, 3);
---
{posts.length > 0 && <section id="articles" class="featured">
  <Container>
    <Reveal class="featured__header"><h2>Актуальные материалы</h2><a href="#archive">Читать все статьи <span aria-hidden="true">→</span></a></Reveal>
    <div class="featured__cards">{posts.map((post,i)=><Reveal delay={i*60}><ArticleCard article={post} /></Reveal>)}</div>
  </Container>
</section>}
<style>
.featured{padding-bottom:var(--section-space)}.featured__header{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:34px}.featured h2{font-size:clamp(44px,4.5vw,64px)}.featured__header>a{font-size:12px;color:var(--color-accent-strong);border-bottom:1px solid var(--color-line);padding-bottom:5px}.featured__cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}@media(max-width:820px){.featured__cards{grid-template-columns:1fr}}@media(max-width:560px){.featured__header{align-items:flex-start;flex-direction:column}}
</style>
